// ---------- 主题色：浅浅墨绿 ----------
:root
  --color-green-light-old: #e5f0ea
  --color-green-light: rgba(229, 240, 234, 0.72)
  --color-mint-light-old: #dce8e2
  --color-mint-light: rgba(220, 232, 226, 0.72)
  --color-cyan-light-old: #e0ebe6
  --color-cyan-light: var(--color-mint-light)
  --color-pink-light-old: #e8f2ec
  --color-pink-light: var(--color-green-light)
  --color-red: #5f8a78
  --color-pink: #6d9684
  --color-orange: #8faf9e
  --color-pink-a3: rgba(95, 138, 120, 0.3)
  --primary-color: #5f8a78
  --nav-bg: linear-gradient(-225deg, var(--color-mint-light) 0, var(--color-green-light) 100%)

[data-theme="dark"]:root
  --color-pink-light: #2a332f
  --color-cyan-light: #2d3532
  --color-red: rgba(134, 175, 157, 0.95)
  --color-pink: rgba(125, 168, 150, 0.9)
  --color-orange: rgba(155, 188, 172, 0.85)
  --color-pink-a3: rgba(134, 175, 157, 0.35)
  --primary-color: #86af9d
  --nav-bg: linear-gradient(-225deg, var(--color-cyan-light) 0, var(--color-pink-light) 100%)

// 文章标题自动编号（1. / 1.1 / 1.1.1）
// 可在 user.config.yml 中设置 postStyle.headingNumber: false 关闭

unless hexo-config('postStyle.headingNumber') == false
  .post.block .body.md
    counter-reset: h2section

    h2
      counter-reset: h3section
      counter-increment: h2section

      &::before
        content: counter(h2section) '. '
        margin-right: .35em
        color: var(--primary-color)
        font-weight: 600

    h3
      counter-reset: h4section
      counter-increment: h3section

      &::before
        content: counter(h2section) '.' counter(h3section) ' '
        margin-right: .35em
        color: var(--primary-color)
        font-weight: 600

    h4
      counter-reset: h5section
      counter-increment: h4section

      &::before
        content: counter(h2section) '.' counter(h3section) '.' counter(h4section) ' '
        margin-right: .35em
        font-weight: 600

    h5
      counter-reset: h6section
      counter-increment: h5section

      &::before
        content: counter(h2section) '.' counter(h3section) '.' counter(h4section) '.' counter(h5section) ' '
        margin-right: .35em

    h6
      counter-increment: h6section

      &::before
        content: counter(h2section) '.' counter(h3section) '.' counter(h4section) '.' counter(h5section) '.' counter(h6section) ' '
        margin-right: .35em

    .note, .tabs, .quiz, blockquote
      h2, h3, h4, h5, h6
        &::before
          content: none !important
